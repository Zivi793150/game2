[Unit]
Description=game_py (Flask via Gunicorn)
After=network.target

[Service]
User=nn
Group=nn
WorkingDirectory=/home/nn/game_py

Environment=FLASK_ENV=production
Environment=SECRET_KEY=change_me_to_long_random
Environment=ALLOWED_ORIGINS=https://hui.endless-summer.ru,http://hui.endless-summer.ru:4444,https://hui.endless-summer.ru:4444

ExecStart=/home/nn/game_py/.venv/bin/gunicorn -w 2 -b 127.0.0.1:5001 main:app
Restart=always

[Install]
WantedBy=multi-user.target